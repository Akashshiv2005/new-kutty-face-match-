# ==============================================================================
# Backend Configuration Template — Copy to .env
# ==============================================================================

PROJECT_NAME="Personalized Children's Storybook"
API_V1_PREFIX=/api/v1
PORT=8000

# PostgreSQL Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/kuttystory_db

# Security & Admin Provisioning
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_NAME="Admin Master"
ADMIN_EMAIL="admin@kuttystory.com"
ADMIN_PASSWORD="YourSecurePasswordHere"
ADMIN_PHONE="+919876543210"


# Set to false to use Cloud Neural Face Swap spaces, true for local offline fallback
PREFER_LOCAL_FUSION=false


# Limits
PER_BOOK_BUDGET_USD=2.50
PREVIEW_PAGE_LIMIT=3
PAID_FALLBACK_ENABLED=false

# SMTP Password Reset Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Kutty Stories"
SMTP_USE_TLS=true
PASSWORD_RESET_CODE_EXPIRE_MINUTES=5

# Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# MinIO Object Storage Configuration (Production & Development)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kuttystory
MINIO_SECURE=false


# CORS Allowed Origins (comma-separated list of permitted origins, strictly driven by .env)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://apikuttystory.risingsuntech.in,https://kuttystory.risingsuntech.in,https://kuttystory2.risingsuntech.in


# Magic Hour Swap Mode (takes from .env: 'face_swap' or 'body_swap')
MAGIC_HOUR_SWAP_MODE=face_swap
MAGIC_HOUR_FACE_SWAP_TOOL=face_swap_photo
MAGIC_HOUR_BODY_SWAP_TOOL=body_swap
MAGIC_HOUR_RESOLUTION=1024px
MAGIC_HOUR_BODY_SWAP_FACE_LOCK=true


FACE_SWAP_PROVIDER=magic_hour
MAGIC_HOUR_API_KEY=
MAGIC_HOUR_ADAPT_FEATURES=false
ALLOW_LOCAL_FALLBACK=false
MAGIC_HOUR_MAX_CONCURRENCY=3
MAGIC_HOUR_MAX_RETRIES=3
MAGIC_HOUR_RETRY_BASE_SECONDS=2.0

# Magic Hour Studio Photo Enhancement / AI Image Editor Configuration
MAGIC_HOUR_ENHANCE_TOOL=ai_image_editor
MAGIC_HOUR_ENHANCE_MODEL=flux-2-klein
MAGIC_HOUR_ENHANCE_RESOLUTION=1024px
MAGIC_HOUR_ENHANCE_PROMPT="Clean professional studio portrait of the person, seamless pure white background, sharp natural studio lighting, crisp facial details, preserve person's exact face, expression, and clothing"
MAGIC_HOUR_ENHANCE_FALLBACK_TOOL=image_background_remover
TIMEZONE=Asia/Kolkata
