# ==============================================================================
# Frontend Environment Configuration Example
# ==============================================================================

PORT=5173
VITE_API_URL=/api/v1
VITE_BACKEND_ORIGIN=https://apikuttystory.risingsuntech.in

# ==============================================================================
# SEO & Production Indexing Gate
# ==============================================================================
# Canonical production site URL (must not end with trailing slash)
VITE_SITE_URL=https://kuttystory.co.in

# Set to "true" ONLY on production to allow search engine indexing and sitemap generation.
# Any other value ("false", unset, "demo") enforces global "noindex,nofollow" and "Disallow: /" in robots.txt.
VITE_INDEXABLE=false

# Search engine verification tags (leave blank if not yet configured)
VITE_GA_MEASUREMENT_ID=
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=

